{
  "name": "dexter-vscode",
  "displayName": "Dexter",
  "description": "A lightning fast Elixir LSP server.",
  "version": "0.2.1",
  "publisher": "remoteoss",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git@gitlab.com:remote-com/employ-starbase/dexter-vscode.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "elixir",
    "lsp",
    "go-to-definition"
  ],
  "activationEvents": [
    "onLanguage:elixir",
    "onLanguage:eex",
    "onLanguage:phoenix-heex",
    "onLanguage:livebook"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "elixir",
        "aliases": [
          "Elixir",
          "elixir"
        ],
        "extensions": [
          ".ex",
          ".exs"
        ],
        "filenames": [
          "mix.lock"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "eex",
        "aliases": [
          "Embedded Elixir",
          "EEx",
          "eex"
        ],
        "extensions": [
          ".eex",
          ".leex"
        ],
        "configuration": "./eex-language-configuration.json"
      },
      {
        "id": "phoenix-heex",
        "aliases": [
          "Phoenix HEEx",
          "HEEx",
          "heex"
        ],
        "extensions": [
          ".heex"
        ],
        "configuration": "./eex-language-configuration.json"
      },
      {
        "id": "livebook",
        "aliases": [
          "Livebook",
          "livebook"
        ],
        "extensions": [
          ".livemd"
        ],
        "configuration": "./livebook-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "elixir",
        "scopeName": "source.elixir",
        "path": "./syntaxes/elixir.json",
        "unbalancedBracketScopes": [
          "keyword.operator.bitwise.elixir",
          "keyword.operator.other.unbalanced.elixir",
          "constant.language.symbol.elixir",
          "constant.language.symbol.single-quoted.elixir",
          "constant.language.symbol.double-quoted.elixir",
          "entity.name.function.call.dot.elixir"
        ],
        "embeddedLanguages": {
          "comment.documentation.heredoc.elixir": "markdown"
        }
      },
      {
        "language": "eex",
        "scopeName": "text.elixir",
        "path": "./syntaxes/eex.json",
        "embeddedLanguages": {
          "meta.embedded.line.elixir": "elixir"
        }
      },
      {
        "language": "phoenix-heex",
        "scopeName": "text.html.elixir",
        "path": "./syntaxes/html-eex.json",
        "embeddedLanguages": {
          "meta.embedded.line.elixir": "elixir"
        }
      },
      {
        "language": "livebook",
        "scopeName": "text.livebook",
        "path": "./syntaxes/livebook.json",
        "embeddedLanguages": {
          "meta.embedded.block.elixir": "elixir"
        }
      }
    ],
    "configurationDefaults": {
      "[elixir]": {
        "editor.formatOnSave": false
      }
    },
    "configuration": {
      "title": "Dexter",
      "properties": {
        "dexter.binary": {
          "type": "string",
          "default": "dexter",
          "description": "Path to the dexter binary. Defaults to 'dexter' (must be on PATH)."
        },
        "dexter.followDelegates": {
          "type": "boolean",
          "default": true,
          "description": "When jumping to a defdelegate, follow through to the target function definition."
        },
        "dexter.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging to stderr."
        },
        "dexter.stdlibPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Elixir standard library (lib/ directory). Auto-detected if not set."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.0.0"
  }
}
